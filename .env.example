# ---- Database ----
MONGO_URL=mongodb+srv://utente:password@cluster/
DB_NAME=tribu_in_viaggio

# ---- Sicurezza (OBBLIGATORIO in produzione: stringa casuale lunga) ----
JWT_SECRET=cambia-con-una-stringa-casuale-di-almeno-40-caratteri

# ---- Modalità ----
# single = un sito per installazione (es. un progetto Emergent per affiliato). Vuoto = multi-sito.
SITE_MODE=
# Solo al primo avvio di un database nuovo: nome del sito e piano iniziale (base | plus | completo)
SITE_NAME=
SITE_PLAN=
# Primo admin del sito (creato se il database non ne ha ancora uno)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Livello Sviluppatore (/sviluppatore). In multi-sito puoi usare anche SUPERADMIN_EMAIL/PASSWORD
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# ---- Multi-sito ----
# Domini del sito master (il tuo). Separati da virgola, senza https:// e senza www.
MASTER_DOMAINS=tribuinviaggio.com,tribuinviaggio.it
# Cosa mostrare per un dominio non registrato: "master" (default) oppure "404"
UNKNOWN_HOST=master
# Primo Super Admin (creato al primo login, poi queste variabili non servono più)
SUPERADMIN_EMAIL=tuaemail@esempio.it
SUPERADMIN_PASSWORD=una-password-robusta
# Anteprima affiliati con ?tenant=slug (true SOLO in sviluppo/anteprima)
TENANT_OVERRIDE=false
# Chiave per creare affiliati dal CRM (POST /api/superadmin/tenants con header X-Platform-Key). Minimo 24 caratteri.
PLATFORM_API_KEY=

# ---- Già esistenti ----
NEXT_PUBLIC_BASE_URL=https://tribuinviaggio.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMERGENT_LLM_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
