# Caddy davanti a Next.js: HTTPS automatico per OGNI dominio degli affiliati.
# Un nuovo affiliato punta il DNS al server -> al primo accesso Caddy chiede al sito
# se il dominio è registrato (/api/platform/domain-check) e solo allora emette il certificato.
{
	on_demand_tls {
		ask http://127.0.0.1:3000/api/platform/domain-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

# Tutto il traffico http passa a https
http:// {
	redir https://{host}{uri} permanent
}
